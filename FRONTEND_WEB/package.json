{
  "name": "frontend-web",
  "version": "0.0.0",
  "main": "src/electron/dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:electron": "tsc -p src/electron/tsconfig.electron.json",
    "electron": "electron .",
    "electron:prod": "ng build --configuration production --base-href ./ && npm run build:electron && electron .",
    "electron:dev": "cross-env NODE_ENV=development ng serve & electron .",
    "clean:release": "rimraf release",
    "dist": "npm run clean:release && ng build --configuration production && electron-builder"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@types/qz-tray": "^2.2.2",
    "angularx-qrcode": "^18.0.0",
    "chart.js": "^4.5.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.11.6",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "ngx-barcode6": "^1.0.26",
    "qz-tray": "^2.2.5",
    "rsvp": "^4.8.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.19",
    "@angular/cli": "^18.2.11",
    "@angular/compiler-cli": "^18.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.15.32",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.5.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.haluc.pdvcontrolcomida",
    "productName": "frontend-web",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/electron/dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "asar": true
  },
  "allowedCommonJsDependencies": [
    "canvg",
    "core-js",
    "raf",
    "rgbcolor",
    "html2canvas",
    "qrcode",
    "jsbarcode"
  ],
  "description": "Aplicación de escritorio para el control de comidas - PROCOMIN",
  "author": "Tu Nombre o Empresa"
}
